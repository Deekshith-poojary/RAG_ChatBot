# --- Ollama (point this at your endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Storage ---
DATA_DIR=data
# QDRANT_URL=http://localhost:6333   # leave unset to use the embedded local file store

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# --- OCR ---
OCR_ENABLED=true
